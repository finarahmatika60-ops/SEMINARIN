<script>
document.addEventListener('DOMContentLoaded',()=>{
  const grid = document.getElementById('seminarGrid');
  const countEl = document.getElementById('resultCount');
  const emptyEl = document.getElementById('emptyState');
  const searchInput = document.getElementById('searchInput');
  const fKat = document.getElementById('filterKategori');
  const fHarga = document.getElementById('filterHarga');
  const fFormat = document.getElementById('filterFormat');
  const fSert = document.getElementById('filterSertifikat');
  const sortBy = document.getElementById('sortBy');
  const resetBtn = document.getElementById('resetBtn');

  // Prefill from URL
  const params = new URLSearchParams(location.search);
  if(params.get('category')) fKat.value = params.get('category');
  if(params.get('q')) searchInput.value = params.get('q');

  function applyFilters(){
    let list = [...SEMINARS];
    const q = searchInput.value.trim().toLowerCase();
    if(q){
      list = list.filter(s =>
        s.judul.toLowerCase().includes(q) ||
        s.kategori.toLowerCase().includes(q) ||
        s.tags.some(t=>t.toLowerCase().includes(q)) ||
        s.deskripsi.toLowerCase().includes(q)
      );
    }
    if(fKat.value) list = list.filter(s=>s.kategori===fKat.value);
    if(fHarga.value === 'gratis') list = list.filter(s=>s.harga===0);
    else if(fHarga.value) list = list.filter(s=>s.harga<=parseInt(fHarga.value));
    if(fFormat.value) list = list.filter(s=>s.format===fFormat.value);
    if(fSert.value === 'ada') list = list.filter(s=>s.sertifikat);
    else if(fSert.value === 'tidak') list = list.filter(s=>!s.sertifikat);

    switch(sortBy.value){
      case 'terbaru': list.sort((a,b)=>new Date(b.tanggal)-new Date(a.tanggal)); break;
      case 'termurah': list.sort((a,b)=>a.harga-b.harga); break;
      case 'termahal': list.sort((a,b)=>b.harga-a.harga); break;
    }
    return list;
  }

  function render(){
    const list = applyFilters();
    countEl.textContent = list.length;
    if(list.length===0){
      grid.innerHTML = '';
      emptyEl.style.display = 'block';
    } else {
      emptyEl.style.display = 'none';
      grid.innerHTML = list.map(createSeminarCard).join('');
      bindFavoriteButtons(grid);
      initReveal();
    }
  }

  [searchInput, fKat, fHarga, fFormat, fSert, sortBy].forEach(el=>{
    el.addEventListener('input', render);
    el.addEventListener('change', render);
  });

  resetBtn.addEventListener('click',()=>{
    searchInput.value=''; fKat.value=''; fHarga.value=''; fFormat.value=''; fSert.value=''; sortBy.value='relevan';
    render();
    showToast('Filter direset ✨');
  });

  render();
});
</script>
</body>
