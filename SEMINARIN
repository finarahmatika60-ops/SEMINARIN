          ${s.manfaat.map(m=>`<li><span class="check">✓</span> ${m}</li>`).join('')}
        </ul>
      </div>

      <div class="detail-section">
        <h3>Tags</h3>
        <div class="card-tags">${s.tags.map(t=>`<span class="tag">#${t}</span>`).join('')}</div>
      </div>

      <div class="detail-actions">
        <button class="btn btn-secondary" id="favBtn">${fav?'❤️ Tersimpan di Favorit':'🤍 Tambahkan ke Favorit'}</button>
        <button class="btn btn-primary" id="daftarBtn">Daftar Sekarang</button>
      </div>
    </div>
  `;

  const favBtn = document.getElementById('favBtn');
  favBtn.addEventListener('click',()=>{
    const nowFav = toggleFavorite(s.id);
    favBtn.textContent = nowFav ? '❤️ Tersimpan di Favorit' : '🤍 Tambahkan ke Favorit';
    showToast(nowFav ? 'Ditambahkan ke favorit ❤️' : 'Dihapus dari favorit', 'success');
  });

  document.getElementById('daftarBtn').addEventListener('click',()=>{
    showToast('Pendaftaran berhasil! Silakan lanjutkan sesuai informasi penyelenggara.', 'success');
  });
});
</script>
</body>
</html>

