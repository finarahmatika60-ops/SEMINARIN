css/style.css
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

:root {
  --cream: #FFF9F5;
  --ivory: #FFFDFB;
  --soft-pink: #FFE4E9;
  --dusty-pink: #F8B4C4;
  --pink-accent: #E89BB0;
  --lavender: #E8E0F5;
  --lavender-deep: #B8A8DC;
  --baby-blue: #E0EEF9;
  --blue-deep: #8FB8DE;
  --dark: #2D2A3E;
  --gray: #6B6880;
  --light-gray: #F5F3F7;
  --white: #FFFFFF;
  --green: #4CAF87;
  --shadow-sm: 0 2px 8px rgba(45,42,62,.06);
  --shadow-md: 0 8px 24px rgba(45,42,62,.08);
  --shadow-lg: 0 16px 48px rgba(45,42,62,.12);
  --radius-sm: 12px;
  --radius-md: 18px;
  --radius-lg: 28px;
  --transition: all .3s cubic-bezier(.4,0,.2,1);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--cream);color:var(--dark);line-height:1.6;overflow-x:hidden}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
button{font-family:inherit;cursor:pointer;border:none;background:none}
input,select,textarea{font-family:inherit}
.container{max-width:1200px;margin:0 auto;padding:0 24px}

/* NAVBAR */
.navbar{position:sticky;top:0;z-index:1000;background:rgba(255,253,251,.85);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid rgba(232,224,245,.4);transition:var(--transition)}
.navbar.scrolled{background:rgba(255,253,251,.97);box-shadow:var(--shadow-sm)}
.nav-inner{max-width:1200px;margin:0 auto;padding:16px 24px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.logo{font-size:1.35rem;font-weight:800;color:var(--dark);display:flex;align-items:center;gap:8px;letter-spacing:-.5px;transition:var(--transition)}
.logo:hover{transform:scale(1.03)}
.logo span{color:var(--pink-accent)}
.nav-menu{display:flex;align-items:center;gap:2px;list-style:none}
.nav-menu a{padding:8px 13px;font-size:.87rem;font-weight:500;color:var(--gray);border-radius:100px;transition:var(--transition);white-space:nowrap}
.nav-menu a:hover{color:var(--dark);background:var(--soft-pink)}
.nav-menu a.active{color:var(--dark);background:var(--soft-pink);font-weight:600}
.nav-cta{display:flex;align-items:center;gap:10px}
.btn-nav{padding:10px 20px;background:var(--dark);color:var(--white);border-radius:100px;font-size:.85rem;font-weight:600;transition:var(--transition);white-space:nowrap}
.btn-nav:hover{background:var(--pink-accent);transform:translateY(-2px);box-shadow:0 8px 20px rgba(232,155,176,.4)}
.hamburger{display:none;flex-direction:column;gap:5px;padding:8px;border-radius:10px;transition:var(--transition)}
.hamburger span{display:block;width:24px;height:2.5px;background:var(--dark);border-radius:10px;transition:var(--transition)}
.hamburger.active span:nth-child(1){transform:translateY(7.5px) rotate(45deg)}
.hamburger.active span:nth-child(2){opacity:0}
.hamburger.active span:nth-child(3){transform:translateY(-7.5px) rotate(-45deg)}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:14px 28px;border-radius:100px;font-weight:600;font-size:.95rem;transition:var(--transition);cursor:pointer;border:none}
.btn-primary{background:var(--dark);color:var(--white)}
.btn-primary:hover{background:var(--pink-accent);transform:translateY(-3px);box-shadow:0 12px 28px rgba(232,155,176,.45)}
.btn-secondary{background:var(--white);color:var(--dark);border:1.5px solid var(--lavender)}
.btn-secondary:hover{border-color:var(--lavender-deep);background:var(--lavender);transform:translateY(-3px)}
.btn-pink{background:var(--dusty-pink);color:var(--white)}
.btn-pink:hover{background:var(--pink-accent);transform:translateY(-3px);box-shadow:0 12px 28px rgba(232,155,176,.45)}
.btn-block{width:100%}

/* HERO */
.hero{padding:60px 0 80px;position:relative;overflow:hidden}
.hero-bg{position:absolute;inset:0;z-index:0;pointer-events:none}
.blob{position:absolute;border-radius:50%;filter:blur(80px);opacity:.5}
.blob-1{width:400px;height:400px;background:var(--soft-pink);top:-100px;right:-50px}
.blob-2{width:350px;height:350px;background:var(--lavender);bottom:-100px;left:-80px}
.blob-3{width:300px;height:300px;background:var(--baby-blue);top:40%;left:40%;opacity:.35}
.hero-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:60px;align-items:center;position:relative;z-index:1}
.badge{display:inline-flex;align-items:center;gap:8px;padding:8px 18px;background:var(--white);border:1.5px solid var(--soft-pink);border-radius:100px;font-size:.78rem;font-weight:700;color:var(--dark);letter-spacing:.5px;margin-bottom:24px;box-shadow:var(--shadow-sm)}
.hero h1{font-size:3.2rem;font-weight:800;line-height:1.1;letter-spacing:-1.5px;margin-bottom:20px;color:var(--dark)}
.hero h1 .highlight{background:linear-gradient(120deg,var(--dusty-pink),var(--lavender-deep));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero p.sub{font-size:1.05rem;color:var(--gray);margin-bottom:32px;max-width:520px}
.hero-buttons{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:40px}
.hero-stats{display:flex;gap:32px;flex-wrap:wrap}
.stat-item h3{font-size:1.6rem;font-weight:800;color:var(--dark)}
.stat-item p{font-size:.85rem;color:var(--gray);font-weight:500}

/* HERO ILLUSTRATION */
.hero-illustration{position:relative;height:480px;display:flex;align-items:center;justify-content:center}
.hero-card-main{width:320px;height:380px;background:linear-gradient(145deg,var(--white),var(--soft-pink));border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:30px;position:relative;animation:floatMain 5s ease-in-out infinite}
.hero-card-main .emoji-big{font-size:5rem;margin-bottom:16px}
.hero-card-main h4{font-size:1.1rem;font-weight:700;text-align:center;margin-bottom:8px}
.hero-card-main p{font-size:.85rem;color:var(--gray);text-align:center}
@keyframes floatMain{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}
.float-item{position:absolute;background:var(--white);border-radius:var(--radius-md);padding:12px 16px;box-shadow:var(--shadow-md);display:flex;align-items:center;gap:8px;font-size:.82rem;font-weight:600;color:var(--dark);animation:floatSoft 4s ease-in-out infinite}
.float-item .fi-icon{font-size:1.2rem}
.fi-1{top:20px;left:0}
.fi-2{top:60px;right:0;animation-delay:.6s}
.fi-3{bottom:60px;left:-10px;animation-delay:1.2s}
.fi-4{bottom:20px;right:10px;animation-delay:1.8s}
.fi-5{top:45%;left:-30px;animation-delay:.9s}
.fi-6{top:40%;right:-25px;animation-delay:1.5s}
@keyframes floatSoft{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-10px) rotate(2deg)}}

/* SECTIONS */
.section{padding:80px 0}
.section-header{text-align:center;margin-bottom:50px}
.section-header h2{font-size:2.2rem;font-weight:800;letter-spacing:-.8px;margin-bottom:12px}
.section-header p{color:var(--gray);font-size:1rem;max-width:560px;margin:0 auto}

/* FEATURES */
.features-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
.feature-card{background:var(--white);border-radius:var(--radius-md);padding:32px 24px;transition:var(--transition);border:1.5px solid transparent;position:relative;overflow:hidden}
.feature-card::before{content:'';position:absolute;top:0;left:0;width:100%;height:4px;background:linear-gradient(90deg,var(--soft-pink),var(--lavender));transform:scaleX(0);transform-origin:left;transition:var(--transition)}
.feature-card:hover{transform:translateY(-8px);box-shadow:var(--shadow-lg);border-color:var(--soft-pink)}
.feature-card:hover::before{transform:scaleX(1)}
.feature-icon{width:56px;height:56px;border-radius:16px;background:var(--soft-pink);display:flex;align-items:center;justify-content:center;font-size:1.6rem;margin-bottom:18px;transition:var(--transition)}
.feature-card:nth-child(2) .feature-icon{background:var(--lavender)}
.feature-card:nth-child(3) .feature-icon{background:var(--baby-blue)}
.feature-card:nth-child(4) .feature-icon{background:#FFF0DC}
.feature-card:hover .feature-icon{transform:scale(1.1) rotate(-6deg)}
.feature-card h3{font-size:1.1rem;font-weight:700;margin-bottom:8px}
.feature-card p{font-size:.9rem;color:var(--gray)}

/* SEMINAR CARD */
.seminar-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:24px}
.seminar-card{background:var(--white);border-radius:var(--radius-md);overflow:hidden;transition:var(--transition);box-shadow:var(--shadow-sm);display:flex;flex-direction:column;border:1.5px solid transparent}
.seminar-card:hover{transform:translateY(-8px);box-shadow:var(--shadow-lg);border-color:var(--soft-pink)}
.card-poster{position:relative;height:170px;overflow:hidden;background:linear-gradient(135deg,var(--soft-pink),var(--lavender));display:flex;align-items:center;justify-content:center}
.card-poster .poster-emoji{font-size:3.5rem;transition:var(--transition)}
.seminar-card:hover .poster-emoji{transform:scale(1.15)}
.card-category{position:absolute;top:12px;left:12px;padding:5px 12px;background:rgba(255,255,255,.92);backdrop-filter:blur(6px);border-radius:100px;font-size:.72rem;font-weight:700;color:var(--dark)}
.fav-btn{position:absolute;top:10px;right:10px;width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.92);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;font-size:1.05rem;transition:var(--transition);z-index:2}
.fav-btn:hover{transform:scale(1.12)}
.fav-btn.active{background:var(--dusty-pink);animation:popFav .4s ease}
@keyframes popFav{0%{transform:scale(1)}50%{transform:scale(1.3)}100%{transform:scale(1)}}
.card-body{padding:20px;display:flex;flex-direction:column;flex:1}
.card-body h3{font-size:1rem;font-weight:700;margin-bottom:12px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:44px}
.card-meta{display:flex;flex-direction:column;gap:6px;margin-bottom:14px;font-size:.82rem;color:var(--gray)}
.card-meta span{display:flex;align-items:center;gap:6px}
.card-tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.tag{padding:3px 10px;background:var(--light-gray);border-radius:100px;font-size:.7rem;font-weight:600;color:var(--gray)}
.card-footer{margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:10px;padding-top:14px;border-top:1px solid var(--light-gray)}
.card-price{font-size:1.05rem;font-weight:800;color:var(--dark)}
.card-price.free{color:var(--green)}
.cert-badge{display:inline-flex;align-items:center;gap:4px;font-size:.72rem;font-weight:600;color:var(--blue-deep);background:var(--baby-blue);padding:3px 8px;border-radius:100px}
.btn-detail{padding:9px 16px;background:var(--dark);color:var(--white);border-radius:100px;font-size:.82rem;font-weight:600;transition:var(--transition);white-space:nowrap}
.btn-detail:hover{background:var(--pink-accent);transform:translateY(-2px)}

/* SEARCH & FILTER */
.page-hero{padding:50px 0 30px;text-align:center}
.page-hero h1{font-size:2.4rem;font-weight:800;letter-spacing:-1px;margin-bottom:10px}
.page-hero p{color:var(--gray);font-size:1rem}
.search-wrap{max-width:720px;margin:30px auto 0;position:relative}
.search-wrap input{width:100%;padding:18px 24px 18px 56px;border-radius:100px;border:1.5px solid var(--lavender);background:var(--white);font-size:.95rem;transition:var(--transition);box-shadow:var(--shadow-sm)}
.search-wrap input:focus{outline:none;border-color:var(--pink-accent);box-shadow:0 0 0 4px rgba(232,155,176,.15)}
.search-wrap .search-icon{position:absolute;left:22px;top:50%;transform:translateY(-50%);font-size:1.1rem;opacity:.6}
.filter-section{padding:30px 0}
.filter-bar{background:var(--white);border-radius:var(--radius-md);padding:20px;box-shadow:var(--shadow-sm);display:flex;flex-wrap:wrap;gap:12px;align-items:end;margin-bottom:24px}
.filter-group{display:flex;flex-direction:column;gap:6px;flex:1;min-width:140px}
.filter-group label{font-size:.75rem;font-weight:700;color:var(--gray);text-transform:uppercase;letter-spacing:.5px}
.filter-group select{padding:11px 14px;border-radius:var(--radius-sm);border:1.5px solid var(--lavender);background:var(--ivory);font-size:.88rem;color:var(--dark);transition:var(--transition);cursor:pointer}
.filter-group select:focus{outline:none;border-color:var(--pink-accent);box-shadow:0 0 0 3px rgba(232,155,176,.15)}
.btn-reset{padding:11px 22px;background:var(--soft-pink);color:var(--dark);border-radius:var(--radius-sm);font-size:.88rem;font-weight:600;transition:var(--transition);white-space:nowrap}
.btn-reset:hover{background:var(--dusty-pink);color:var(--white)}
.result-info{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:10px}
.result-info p{font-size:.9rem;color:var(--gray)}
.result-info strong{color:var(--dark)}
.empty-state{text-align:center;padding:80px 20px}
.empty-state .emoji-big{font-size:4rem;margin-bottom:16px}
.empty-state h3{font-size:1.3rem;font-weight:700;margin-bottom:8px}
.empty-state p{color:var(--gray);margin-bottom:24px}

/* CATEGORY */
.category-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px}
.category-card{background:var(--white);border-radius:var(--radius-md);padding:32px 24px;text-align:center;transition:var(--transition);cursor:pointer;border:1.5px solid transparent}
.category-card:hover{transform:translateY(-8px);box-shadow:var(--shadow-lg);border-color:var(--soft-pink)}
.category-card .cat-icon{width:70px;height:70px;border-radius:20px;background:var(--soft-pink);display:flex;align-items:center;justify-content:center;font-size:2rem;margin:0 auto 16px;transition:var(--transition)}
.category-card:nth-child(2) .cat-icon{background:var(--lavender)}
.category-card:nth-child(3) .cat-icon{background:var(--baby-blue)}
.category-card:nth-child(4) .cat-icon{background:#FFE9E9}
.category-card:nth-child(5) .cat-icon{background:#FFF0DC}
.category-card:nth-child(6) .cat-icon{background:#E5F5EA}
.category-card:hover .cat-icon{transform:scale(1.1) rotate(-6deg)}
.category-card h3{font-size:1.05rem;font-weight:700;margin-bottom:6px}
.category-card p{font-size:.82rem;color:var(--gray)}
.chips-wrap{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}
.chip{padding:10px 20px;background:var(--white);border:1.5px solid var(--lavender);border-radius:100px;font-size:.88rem;font-weight:600;color:var(--dark);transition:var(--transition);cursor:pointer}
.chip:hover{background:var(--soft-pink);border-color:var(--soft-pink);transform:translateY(-3px)}

/* FORM */
.form-grid{display:grid;grid-template-columns:1fr 1.3fr;gap:50px;align-items:start}
.form-illustration{background:linear-gradient(145deg,var(--soft-pink),var(--lavender));border-radius:var(--radius-lg);padding:40px;min-height:400px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;position:sticky;top:100px}
.form-illustration .emoji-big{font-size:5rem;margin-bottom:20px;animation:floatMain 4s ease-in-out infinite}
.form-illustration h3{font-size:1.3rem;font-weight:700;margin-bottom:10px}
.form-illustration p{color:var(--gray);font-size:.92rem}
.form-card{background:var(--white);border-radius:var(--radius-lg);padding:36px;box-shadow:var(--shadow-md)}
.form-group{margin-bottom:18px}
.form-group label{display:block;font-size:.85rem;font-weight:600;margin-bottom:7px;color:var(--dark)}
.form-group label .req{color:var(--pink-accent)}
.form-group input,.form-group select,.form-group textarea{width:100%;padding:13px 16px;border-radius:var(--radius-sm);border:1.5px solid var(--lavender);background:var(--ivory);font-size:.9rem;color:var(--dark);transition:var(--transition)}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{outline:none;border-color:var(--pink-accent);background:var(--white);box-shadow:0 0 0 4px rgba(232,155,176,.12)}
.form-group textarea{resize:vertical;min-height:90px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.error-msg{font-size:.78rem;color:#E05A7A;margin-top:5px;display:none}
.form-group.error input,.form-group.error select,.form-group.error textarea{border-color:#E05A7A;background:#FFF5F7}
.form-group.error .error-msg{display:block}

/* PRICING */
.pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;align-items:stretch}
.pricing-card{background:var(--white);border-radius:var(--radius-lg);padding:36px 30px;transition:var(--transition);border:2px solid transparent;position:relative;display:flex;flex-direction:column}
.pricing-card:hover{transform:translateY(-8px);box-shadow:var(--shadow-lg)}
.pricing-card.featured{border-color:var(--dusty-pink);background:linear-gradient(180deg,var(--white),var(--soft-pink));transform:scale(1.03)}
.pricing-card.featured:hover{transform:scale(1.03) translateY(-8px)}
.rec-badge{position:absolute;top:-14px;left:50%;transform:translateX(-50%);padding:6px 18px;background:var(--dark);color:var(--white);border-radius:100px;font-size:.75rem;font-weight:700;letter-spacing:.5px;white-space:nowrap}
.pricing-card h3{font-size:.85rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--gray);margin-bottom:14px}
.pricing-price{font-size:2.6rem;font-weight:800;color:var(--dark);margin-bottom:4px;letter-spacing:-1px}
.pricing-price span{font-size:1rem;font-weight:600;color:var(--gray)}
.pricing-desc{font-size:.88rem;color:var(--gray);margin-bottom:24px;padding-bottom:24px;border-bottom:1px solid var(--light-gray)}
.pricing-features{list-style:none;margin-bottom:28px;flex:1}
.pricing-features li{display:flex;align-items:flex-start;gap:10px;font-size:.9rem;color:var(--gray);margin-bottom:12px}
.pricing-features li .check{color:var(--pink-accent);font-weight:700;flex-shrink:0}

/* ABOUT */
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center}
.about-visual{background:linear-gradient(145deg,var(--lavender),var(--baby-blue));border-radius:var(--radius-lg);padding:50px 40px;text-align:center;position:relative;overflow:hidden}
.about-visual .emoji-big{font-size:6rem;margin-bottom:20px;animation:floatMain 5s ease-in-out infinite}
.about-visual h3{font-size:1.2rem;font-weight:700;margin-bottom:8px}
.about-visual p{color:var(--gray);font-size:.9rem}
.visi-box{background:var(--white);border-left:4px solid var(--dusty-pink);padding:24px 28px;border-radius:var(--radius-md);margin:30px 0;box-shadow:var(--shadow-sm)}
.visi-box h4{font-size:.8rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--pink-accent);margin-bottom:8px}
.visi-box p{font-size:1.05rem;font-style:italic;color:var(--dark);line-height:1.5}
.highlight-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:50px}
.highlight-card{background:var(--white);border-radius:var(--radius-md);padding:28px 22px;text-align:center;transition:var(--transition);box-shadow:var(--shadow-sm)}
.highlight-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-md)}
.highlight-card .hl-icon{font-size:2.2rem;margin-bottom:12px}
.highlight-card h4{font-size:1rem;font-weight:700;margin-bottom:6px}
.highlight-card p{font-size:.85rem;color:var(--gray)}

/* CONTACT */
.contact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.contact-card{background:var(--white);border-radius:var(--radius-md);padding:36px 28px;text-align:center;transition:var(--transition);border:1.5px solid transparent;display:block}
.contact-card:hover{transform:translateY(-8px);box-shadow:var(--shadow-lg);border-color:var(--soft-pink)}
.contact-card .cc-icon{width:64px;height:64px;border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:1.8rem;margin:0 auto 18px;transition:var(--transition)}
.contact-card:nth-child(1) .cc-icon{background:#E5F5EA}
.contact-card:nth-child(2) .cc-icon{background:var(--soft-pink)}
.contact-card:nth-child(3) .cc-icon{background:var(--lavender)}
.contact-card:hover .cc-icon{transform:scale(1.1) rotate(-6deg)}
.contact-card h3{font-size:1.05rem;font-weight:700;margin-bottom:6px}
.contact-card p{font-size:.9rem;color:var(--gray);word-break:break-word}
.contact-card .cc-action{margin-top:14px;font-size:.82rem;font-weight:700;color:var(--pink-accent)}

/* DETAIL */
.detail-wrap{display:grid;grid-template-columns:1fr 1.3fr;gap:50px;padding:40px 0 80px}
.detail-poster{background:linear-gradient(145deg,var(--soft-pink),var(--lavender));border-radius:var(--radius-lg);height:340px;display:flex;align-items:center;justify-content:center;font-size:6rem;box-shadow:var(--shadow-md);position:sticky;top:100px}
.detail-body h1{font-size:2rem;font-weight:800;letter-spacing:-.8px;margin-bottom:14px;line-height:1.2}
.detail-cat{display:inline-block;padding:6px 14px;background:var(--soft-pink);border-radius:100px;font-size:.78rem;font-weight:700;margin-bottom:16px}
.detail-meta{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:24px 0}
